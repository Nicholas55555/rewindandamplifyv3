# Publish the project, not the surrounding research workspace.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/Rewind_Amplify_Research_Explorer.html
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/CONTRIBUTING.md
!/requirements-dev.txt
!/requirements-tools.txt
!/docs/
!/.github/
!/START_HERE_FINALS.md
!/FINALS_*.md
!/RESEARCH_RESULTS.md
!/RESEARCH_CURRENT.md
!/RESEARCH_CONTINUATION_PLAN.md
!/RESEARCH_ARCHIVE_MANIFEST.json
!/VIABILITY_FINDINGS.md
!/QUANTUM_PHOTOLITHOGRAPHY_ROADMAP.md
!/LASER_DIAGNOSTICS_ROADMAP.md
!/LASER_SENSOR_RESEARCH_PLAN.md
!/build_finals_pack.py
!/check_finals.py
!/build_research_pack.py
!/verify_research_pack.py
!/rewindandamplify-main/
!/qrsm_photon_poc/
!/laser_sensor_poc/
!/laser_sensor_viability/
!/quantum_lithography_poc/
!/quantum_dot_bridge/
!/hardware_campaign/
!/applied/
!/finals-lithography/
!/photon_reference/
!/external_data/
!/research-validation/
!/laser-diagnostics-app/
!/lab/
!/media/
!/index.html
!/.nojekyll
!/Rewind_Amplify_Lab.html
!/reproduce.py
!/animations/
!/finals-deck/
!/.finals-deck-build/

# Only the current editable deck, sources and verification receipts.
/.finals-deck-build/*
!/.finals-deck-build/visual_build.mjs
!/.finals-deck-build/visual_render_final.mjs
!/.finals-deck-build/visual_finish.py
!/.finals-deck-build/visual_notes.json
!/.finals-deck-build/visual_validation_ibm_campaign_v8.json
!/.finals-deck-build/visual_review.json
/finals-deck/archive/
/finals-deck/*
!/finals-deck/README.md
!/finals-deck/Rewind_Amplify_Finals_V3.pptx
!/finals-deck/Rewind_Amplify_Finals_V3.pdf
!/finals-deck/Presenter_Guide_V3.md
!/finals-deck/main-slides.png
!/finals-deck/backup-slides.png
!/finals-deck/v3_manifest.json
!/finals-deck/v3_notes.json
!/finals-deck/build_v3_deck.py
!/finals-deck/deck_kit.py
!/finals-deck/v3_backups.py
!/finals-deck/finish_v3_deck.py
!/finals-deck/finish_v3_deck.ps1
!/finals-deck/assets/
!/finals-deck/v2/

# Superseded circuit binaries; preserve the bounded-attempt JSON reports.
/finals-lithography/full_spatial_circuit/archive/*.qpy
/quantum_dot_bridge/*_rerun*
/hardware_campaign/original_bundle_v1/
/hardware_campaign/runs/original_plain_v1/
/hardware_campaign/runs/optical_dilation_plain_v1/isa.qpy
/hardware_campaign/submission.lock

# Local environments, caches, temporary files and credentials.
**/__pycache__/
**/.pytest_cache/
**/.venv/
**/venv/
**/node_modules/
**/*.egg-info/
*.py[cod]
*.partial
*.tmp
*.building
*.staging
*.token
.env
.env.*
!.env.example
qiskit-ibm.json
ibm-quantum.json
*.pem
*.key
.DS_Store
Thumbs.db
**/.vscode/
**/.idea/
